---
import { translations, getModeStrings, initialCountLabel, pickClientStrings } from "../../server/i18n.ts";
import type { Locale } from "../../server/i18n.ts";
import type { Mode } from "../../server/types.ts";
import { settings } from "../../server/settings.ts";
import {
  buildJsonLd,
  safeJsonForScript,
  hreflangPaths,
  SEO_HIDDEN,
} from "../lib/seo.ts";

interface Props {
  locale: Locale;
  mode: Mode;
}

const { locale, mode } = Astro.props;
const s = translations[locale];
const ms = getModeStrings(locale, mode);
const initialCount = initialCountLabel(locale, mode);
const origin = settings.siteOrigin;

// Same-mode hreflang alternates; the current locale's path is the canonical.
const hreflang = hreflangPaths(mode);
const canonicalPath = locale === "en" ? hreflang.en : hreflang.fi;
const canonicalUrl = origin + canonicalPath;
const jsonLd = buildJsonLd(locale, ms, canonicalUrl);
const i18nScript = `window.__i18n=${safeJsonForScript({ locale, strings: pickClientStrings(s) })};`;

// Active-link hrefs (current LOCALE's mode paths).
const tramHref = locale === "en" ? "/en/trams" : "/ratikat";
const busHref = locale === "en" ? "/en/buses" : "/bussit";

const otherLocale: Locale = locale === "fi" ? "en" : "fi";
const seoHiddenPrimaryText = SEO_HIDDEN[mode][locale];
const seoHiddenSecondaryText = SEO_HIDDEN[mode][otherLocale];

Astro.response.headers.set("Content-Type", "text/html; charset=utf-8");
Astro.response.headers.set("Content-Language", locale);
Astro.response.headers.set("Cache-Control", "public, max-age=60, must-revalidate");
---
<!doctype html>
<html lang={locale} data-mode={mode}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0d0f12" />
  <meta name="generator" content={Astro.generator} />
  <title>{ms.title}</title>
  <meta name="description" content={ms.description}>
  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" hreflang="fi" href={`${origin}${hreflang.fi}`}>
  <link rel="alternate" hreflang="en" href={`${origin}${hreflang.en}`}>
  <link rel="alternate" hreflang="x-default" href={`${origin}${hreflang.fi}`}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Raitsikat">
  <meta property="og:title" content={ms.ogTitle}>
  <meta property="og:description" content={ms.ogDescription}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={`${origin}/icons/og-image.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={ms.ogImageAlt}>
  <meta property="og:locale" content={s.ogLocale}>
  <meta property="og:locale:alternate" content={s.ogLocaleAlternate}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ms.twitterTitle}>
  <meta name="twitter:description" content={ms.twitterDescription}>
  <meta name="twitter:image" content={`${origin}/icons/og-image.png`}>
  <meta name="twitter:image:alt" content={ms.ogImageAlt}>
  <script type="application/ld+json" is:inline set:html={jsonLd}></script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" /></noscript>
  <link rel="stylesheet" href="/style.css" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
  <link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/icons/icon-180.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Raitsikat" />

  <script is:inline set:html={i18nScript}></script>
  <script is:inline defer src="https://vahti.rigster.cv/script.js" data-website-id="2b352cb3-1936-4060-9fb3-6d18ee2aa4e0"></script>
</head>
<body>
  <noscript>
    <article class="seo-fallback">
      <h1>{ms.noscriptH1}</h1>
      <p>{ms.noscriptP1}</p>
      <p>{ms.noscriptP2}</p>
    </article>
  </noscript>

  <!--
    Visually-hidden copy for crawlers that execute JS (which never see the
    <noscript> article). Duplicates the noscript text on purpose: only one
    of the two is ever rendered to a given user.
  -->
  <div class="seo-hidden">
    <h1>{ms.noscriptH1}</h1>
    <p>{ms.noscriptP1}</p>
    <p>{ms.noscriptP2}</p>
    <p lang={locale}>{seoHiddenPrimaryText}</p>
    <p lang={otherLocale}>{seoHiddenSecondaryText}</p>
  </div>

  <div id="conn-toast" role="status" aria-live="polite" hidden>
    <span class="conn-toast__dot" aria-hidden="true"></span>
    <span class="conn-toast__label"></span>
  </div>
  <div id="map" aria-label={s.mapAria}></div>

  <header id="topbar">
    <div class="brand">
      <span class="brand__name">Raitsikat</span>
    </div>
    <nav id="mode-tabs" aria-label={s.vehicleModeAria}>
      <a href={tramHref} data-mode="tram" aria-current={mode === "tram" ? "page" : undefined}>{s.tabTrams}</a>
      <a href={busHref} data-mode="bus" aria-current={mode === "bus" ? "page" : undefined}>{s.tabBuses}</a>
    </nav>
    <span id="vehicle-count-top" class="topbar__count" data-vehicle-count>{initialCount}</span>
    <a id="lang-switch"
       href={ms.langSwitchHref}
       hreflang={s.langSwitchTargetLocale}
       lang={s.langSwitchTargetLocale}
       aria-label={s.langSwitchAria}>{s.langSwitchText}</a>
  </header>

  <section id="sheet" aria-label={s.sheetLines}>
    <button id="sheet-toggle" aria-expanded="false" aria-controls="sheet-body">
      <span class="sheet__handle" aria-hidden="true"></span>
      <span class="sheet__title">{s.sheetLines}</span>
      <span class="sheet__count" id="vehicle-count" data-vehicle-count>{initialCount}</span>
    </button>
    <div id="sheet-body">
      <div id="line-filter" role="group" aria-label={s.lineFilterAria}></div>
    </div>
  </section>

  <script>
    import "../scripts/main.ts";
  </script>
</body>
</html>
